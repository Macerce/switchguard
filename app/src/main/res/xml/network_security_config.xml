<?xml version="1.0" encoding="utf-8"?>
<!--
  Uygulamanın kendi bağlantıları (eWeLink, Tuya, Telegram, Open-Meteo, GitHub) hep https://. Şifresiz http:// yalnızca
  kullanıcının kendi girdiği canlılık / ntfy / webhook adresleri için gerekir (ör. yerel ağdaki Uptime Kuma ya da
  Home Assistant: http://192.168.1.10:8123/api/webhook/...).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
