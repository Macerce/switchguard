    <!-- Onboarding -->
    <string name="onb_welcome_title">Welcome to SwitchGuard</string>
    <string name="onb_welcome_body">Get an alarm the moment your Sonoff / eWeLink-compatible devices switch on or off or lose their connection.</string>
    <string name="onb_feature_alarm">An alarm that keeps ringing until you dismiss it</string>
    <string name="onb_feature_control">Switch devices on and off from the app</string>
    <string name="onb_feature_rules">Per-device rules and quiet hours</string>
    <string name="onb_feature_history">Full event history</string>
    <string name="onb_dev_title">Create a free developer app</string>
    <string name="onb_dev_body">SwitchGuard talks to your devices through eWeLink\'s official API. You need your own free App ID for this — it takes about two minutes.</string>
    <string name="onb_dev_step1">Open dev.ewelink.cc and sign in with the eWeLink account your devices are in.</string>
    <string name="onb_dev_step2">Register as a developer (the free standard role is enough).</string>
    <string name="onb_dev_step3">Create an app and set its Redirect URL to %s</string>
    <string name="onb_dev_step4">Copy the App ID and App Secret you are given.</string>
    <string name="onb_open_portal">Open dev.ewelink.cc</string>
    <string name="onb_copy_redirect">Copy Redirect URL</string>
    <string name="onb_dev_brand_note">Note: free developer apps work with SONOFF-branded devices.</string>
    <string name="onb_cred_title">Enter your API credentials</string>
    <string name="onb_cred_body">Paste the App ID and App Secret from your developer app.</string>
    <string name="onb_cred_privacy">These are stored only on this phone and are never sent anywhere except eWeLink.</string>
    <string name="onb_login_title">Sign in to eWeLink</string>
    <string name="onb_login_body">You\'ll sign in on eWeLink\'s own page. SwitchGuard never sees your password.</string>
    <string name="onb_perm_title">Allow alarms</string>
    <string name="onb_perm_body">Two permissions make sure alarms reach you, even when the screen is off.</string>
    <string name="onb_perm_notif_desc">Required to show alarms.</string>
    <string name="onb_perm_battery_desc">Lets monitoring keep running in the background so alarms aren\'t delayed.</string>
    <string name="onb_done_title">All set!</string>
    <string name="onb_done_body">Start monitoring now. You can fine-tune everything later.</string>
    <string name="onb_done_tip_rules">Tap a device to choose which events ring an alarm</string>
    <string name="onb_done_tip_test">Use “Test alarm” in Settings to check the sound</string>

